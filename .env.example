# WhatsApp Cloud API Configuration
# Get these values from Meta for Developers (https://developers.facebook.com/)

# Your WhatsApp Business Account access token
WHATSAPP_TOKEN=your_access_token_here

# Your WhatsApp Business phone number ID
PHONE_NUMBER_ID=your_phone_number_id_here

# Custom token for webhook verification (you choose this)
VERIFY_TOKEN=my_secret_verify_token

# Server port (default: 3000)
PORT=3000

# Optional: Database configuration (if using MongoDB)
# MONGODB_URI=mongodb://localhost:27017/whatsapp_bot

# Optional: Database path (if using SQLite)
# DB_PATH=./data/bot.db

# Environment (development/production)
NODE_ENV=development
