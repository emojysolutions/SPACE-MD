# Queen Angela MD Configuration

# Bot Name
BOT_NAME=Queen Angela MD

# Session ID (optional)
SESSION_ID=

# Bot Admin Phone Number (with country code)
BOT_ADMIN=YOUR_PHONE_NUMBER

# GitHub Username (required for non-premium users)
GITHUB_USERNAME=

# Bot Password (8 digits, numbers only)
BOT_PASSWORD=your_8_digit_password

# Admin Password (8 digits, numbers only)
ADMIN_PASSWORD=your_8_digit_admin_password

# Telegram Bot Token (optional)
TELEGRAM_BOT_TOKEN=

# Anti-Delete/Edit (true/false)
ANTI_DELETE=false

# Premium Settings (leave blank if not a premium user)
PREMIUM_KEY=
MAX_SESSIONS=
EXPIRY=
